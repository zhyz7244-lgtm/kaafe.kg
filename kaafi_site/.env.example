# Скопируйте этот файл в ".env" (рядом с manage.py) и заполните.
# Адрес сайта — он зашивается в QR-коды столов. Пример: https://kaafi.kg
SITE_URL=http://127.0.0.1:8000

# Telegram-уведомления о заказах (необязательно).
# 1) В Telegram откройте @BotFather -> /newbot -> скопируйте токен сюда.
# 2) Напишите своему боту любое сообщение, затем выполните:
#      python manage.py telegram_setup
#    Команда найдёт ваш chat id и пришлёт тестовое сообщение.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp-уведомления (необязательно) через бесплатный CallMeBot:
# https://www.callmebot.com/blog/free-api-whatsapp-messages/ (бот: +34 644 99 26 98)
# Номер в международном формате без плюса, например 996555123456.
WHATSAPP_PHONE=
CALLMEBOT_APIKEY=

# Для публикации в интернет:
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=длинная-случайная-строка
# DJANGO_ALLOWED_HOSTS=kaafi.kg,www.kaafi.kg
# DJANGO_CSRF_TRUSTED_ORIGINS=https://kaafi.kg
