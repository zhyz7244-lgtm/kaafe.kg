# Скопируйте в .env и заполните. Без этих значений уведомления просто не отправляются
# (заказы всё равно видны в админке со звуковым сигналом).

# Telegram: создайте бота у @BotFather, напишите ему /start, chat id узнайте у @userinfobot.
# Несколько получателей — через запятую.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp через бесплатный шлюз CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
# Номер в международном формате, например 996555123456
WHATSAPP_PHONE=
CALLMEBOT_APIKEY=
